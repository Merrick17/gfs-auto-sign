generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MailboxConnection {
  id            String              @id @default(cuid())
  mailboxId     String              @unique
  tenantId      String
  subscriptions GraphSubscription[]
  events        IncomingEvent[]
  createdAt     DateTime            @default(now())
}

model GraphSubscription {
  id          String            @id @default(cuid())
  graphId     String            @unique
  mailboxId   String
  mailbox     MailboxConnection @relation(fields: [mailboxId], references: [id])
  resource    String
  clientState String
  expiresAt   DateTime
  status      String            @default("active")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([expiresAt])
}

// Inbox/outbox row: persisted before ack, stays PENDING until Trigger.dev accepted the run.
model IncomingEvent {
  id             String            @id @default(cuid())
  mailboxId      String
  mailbox        MailboxConnection @relation(fields: [mailboxId], references: [id])
  dedupeKey      String            @unique
  kind           String // message.created | lifecycle
  graphMessageId String?
  subscriptionId String
  payload        Json
  dispatchStatus String            @default("PENDING") // PENDING | DISPATCHED
  triggerRunId   String?
  dispatchedAt   DateTime?
  attempts       Int               @default(0)
  receivedAt     DateTime          @default(now())
  job            ProcessingJob?

  @@index([dispatchStatus, receivedAt])
}

model ProcessingJob {
  id        String        @id @default(cuid())
  eventId   String        @unique
  event     IncomingEvent @relation(fields: [eventId], references: [id])
  stage     String        @default("EMAIL_RECEIVED")
  status    String        @default("RUNNING") // RUNNING | COMPLETED | FAILED
  detail    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// One PDF attachment of one email. Named Contract for history; the interface calls it a document.
model Contract {
  id             String             @id @default(cuid())
  mailboxId      String
  graphMessageId String
  attachmentId   String
  attachmentName String
  contentHash    String // sha256 of the original PDF
  subject        String?
  senderAddress  String?
  senderName     String?
  receivedAt     DateTime?
  conversationId String?
  // RECEIVED | NEEDS_ATTENTION | SKIPPED | SIGNING | SIGNED | DRAFTING | DRAFT_SAVED | FAILED
  status         String             @default("RECEIVED")
  attention      String? // PLACEMENT | APPROVAL | REVIEW | SETUP, set while status is NEEDS_ATTENTION
  exception      String? // one plain sentence for the owner
  placement      Json? // where the signature went or will go: { page, x, y, width, height } as page fractions
  pageCount      Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  analyses       ContractAnalysis[]
  documents      DocumentRef[]
  draft          OutlookDraft?
  audits         AuditEvent[]

  // Same attachment bytes of the same message are processed once.
  @@unique([mailboxId, graphMessageId, attachmentId, contentHash])
  @@index([status, createdAt])
  @@index([contentHash])
}

model ContractAnalysis {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id])
  model        String
  result       Json
  decision     String
  reasons      Json
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 4)
  createdAt    DateTime @default(now())

  @@index([contractId])
}

model DocumentRef {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  kind       String // ORIGINAL | SIGNED
  driveId    String
  itemId     String
  sha256     String
  createdAt  DateTime @default(now())

  @@unique([contractId, kind])
}

model OutlookDraft {
  id           String   @id @default(cuid())
  contractId   String   @unique
  contract     Contract @relation(fields: [contractId], references: [id])
  graphDraftId String?
  webLink      String?
  state        String   @default("CREATING") // CREATING | CREATED | ATTACHED
  marker       String   @unique // extended-property marker used to find a draft whose create call had no answer
  to           Json?
  cc           Json?
  attachmentOk Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditEvent {
  id         String    @id @default(cuid())
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  actor      String // system | owner
  action     String
  data       Json?
  createdAt  DateTime  @default(now())

  @@index([contractId, createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UsageRecord {
  id           String   @id @default(cuid())
  source       String // openai
  contractId   String?
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @db.Decimal(10, 4)
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([source, createdAt])
}

// Delegated Microsoft sign-in of the single owner. The refresh token is stored sealed (AES-256-GCM).
model OAuthConnection {
  id           String   @id @default(cuid())
  userOid      String   @unique
  accountEmail String?
  accountName  String?
  refreshToken String
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// How the reply draft is prepared for one sender address or one sender domain ("@example.com").
model SenderRule {
  id        String   @id @default(cuid())
  sender    String   @unique // lowercase address, or "@domain"
  to        String[] // empty: reply to the sender
  cc        String[]
  autoSign  Boolean  @default(false)
  placement Json? // remembered signature position: { page, x, y, width, height, pageCount }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Versioned signature images. The file lives in the owner's OneDrive; only the reference is stored.
model SignatureImage {
  id        String    @id @default(cuid())
  version   Int       @unique
  driveId   String
  itemId    String
  fileName  String
  sha256    String
  sizeBytes Int
  width     Int
  height    Int
  active    Boolean   @default(true)
  removedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

// People the owner has corresponded with. Names and addresses only, never message bodies.
model Contact {
  id                String    @id @default(cuid())
  email             String    @unique
  displayName       String
  organization      String?
  domain            String
  sources           String[]
  outlookContactId  String?
  lastInteractionAt DateTime?
  toCount           Int       @default(0)
  ccCount           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([domain])
}

// One row per recipient of a sent message: the raw material for "frequently copied for this sender".
model SentRecipient {
  id             String   @id @default(cuid())
  messageId      String
  email          String
  role           String // to | cc
  conversationId String?
  sentAt         DateTime
  toDomains      String[]

  @@unique([messageId, email, role])
  @@index([email])
  @@index([conversationId])
  @@index([sentAt])
}
