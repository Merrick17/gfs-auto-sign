# --- Neon: pooled URL for the app and tasks, direct URL for migrations ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Trigger.dev (set the same secrets in the Trigger.dev dashboard for deployed tasks) ---
# Project ref is set in trigger.config.ts
TRIGGER_SECRET_KEY=

# --- Microsoft Entra: delegated OAuth (Mail.Read, Mail.ReadWrite, Files.ReadWrite; never Mail.Send) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MAILBOX_ID=                 # fallback label for the signed-in owner's mailbox
APP_BASE_URL=               # public https origin of the app; Graph webhooks need it
SHAREPOINT_DRIVE_ID=        # optional: library drive id; unset uses the owner's OneDrive
SHAREPOINT_ROOT_FOLDER=     # optional: app folder in the drive; defaults to "GFS Contracts"

# --- Owner sign-in (Auth.js) ---
AUTH_SECRET=                # openssl rand -base64 32
OWNER_OBJECT_ID=            # Entra object id(s) (oid) allowed to sign in, comma-separated
OWNER_EMAILS=               # sign-in emails allowed, comma-separated

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-6-luna

# --- Signing material: set on BOTH the app host and Trigger.dev ---
CERT_ENCRYPTION_KEY=        # openssl rand -base64 32
SIGNING_P12_PASSWORD=
