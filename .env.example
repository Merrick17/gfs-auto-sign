# --- Neon (written by `neon env pull` into .env.local: pooled URL for app/tasks, DATABASE_URL_UNPOOLED for migrations) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Trigger.dev (set the same project secrets in the Trigger.dev dashboard for deployed tasks) ---
# Project ref is set in trigger.config.ts (proj_bfnmijwmujfncdqfciyc)
TRIGGER_SECRET_KEY=

# --- Microsoft Entra / Graph (application permissions: Mail.Read, Mail.ReadWrite, Sites.Selected; NO Mail.Send) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MAILBOX_ID=                 # user principal name or object id of the monitored mailbox
SHAREPOINT_DRIVE_ID=        # document library drive id
APP_BASE_URL=               # public https origin of the Vercel app

# --- Owner sign-in (Auth.js) ---
AUTH_SECRET=                # openssl rand -base64 32
OWNER_OBJECT_ID=            # Entra object id (oid) of the single allowed owner

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-6-luna
OPENAI_MODEL_ESCALATION=gpt-6.1-sol
# USD per 1M tokens, from your OpenAI price list. Key = model id upper-cased, non-alphanumerics as _
PRICE_IN_GPT_6_LUNA=
PRICE_OUT_GPT_6_LUNA=
PRICE_IN_GPT_6_1_SOL=
PRICE_OUT_GPT_6_1_SOL=

# --- Signing material: set CERT_ENCRYPTION_KEY and SIGNING_P12_PASSWORD on BOTH Vercel (import) and Trigger.dev (signing) ---
CERT_ENCRYPTION_KEY=        # openssl rand -base64 32
SIGNING_P12_PASSWORD=

SHAREPOINT_ROOT_FOLDER=      # folder inside the library for the app files, e.g. "GFS Trade Finance/GFS Contract Agent"
